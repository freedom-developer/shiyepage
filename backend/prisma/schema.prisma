generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  passwordHash   String
  role           String            @default("ADMIN")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  resources      Resource[]
  progress       ReadingProgress[]
}

model Subject {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  shortTitle  String
  icon        String
  color       String
  description String
  sortOrder   Int           @default(0)
  nodes       CatalogNode[]
  resources   Resource[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model CatalogNode {
  id          String        @id @default(cuid())
  subjectId   String
  parentId    String?
  slug        String
  title       String
  description String?
  sortOrder   Int           @default(0)
  subject     Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent      CatalogNode?  @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    CatalogNode[] @relation("NodeChildren")
  resources   Resource[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([subjectId, parentId, slug])
  @@index([subjectId, parentId])
}

model Resource {
  id           String            @id @default(cuid())
  kind         String
  title        String
  summary      String            @default("")
  subjectId    String
  nodeId       String?
  content      String?
  searchText   String            @default("")
  storagePath  String?
  originalName String?
  mimeType     String?
  sizeBytes    Int?
  pageCount    Int?
  isPrivate    Boolean           @default(true)
  ownerId      String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  subject      Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  node         CatalogNode?      @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  progress     ReadingProgress[]

  @@index([subjectId, nodeId])
  @@index([kind, isPrivate])
}

model ReadingProgress {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  page       Int      @default(1)
  percent    Float    @default(0)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
}
